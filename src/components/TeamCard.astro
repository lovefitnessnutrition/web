---
import { buildWhatsAppLink } from "../utils/whatsapp";
import { buildTelegramLink } from "../utils/telegram";
import WhatsAppIcon from "./WhatsAppIcon.astro";
import TelegramIcon from "./TelegramIcon.astro";

interface Props {
  name: string;
  role: string;
  bio: string;
  specialties: string[];
  photo: string;
  whatsappNumber: string;
  accent?: string;
  glow?: boolean;
}

const { name, role, bio, specialties, photo, whatsappNumber, accent, glow } = Astro.props;
const waLink = buildWhatsAppLink(whatsappNumber, `Hola ${name}, quiero información.`);
const tgLink = buildTelegramLink(whatsappNumber);
---

<article
  class:list={["team-card", "card", { "has-accent": accent, "has-glow": accent && glow }]}
  style={accent ? `--card-accent: ${accent}` : undefined}
>
  <img src={photo} alt={`Foto de ${name}`} class="team-photo" loading="lazy" decoding="async" width="600" height="380" />
  <div class="team-body">
    <h3 class="team-name">{name}</h3>
    <p class="team-role">{role}</p>
    <p class="team-bio">{bio}</p>
    <div class="team-specialties">
      {specialties.map((s) => <span class="tag">{s}</span>)}
    </div>
    <div class="team-contact">
      <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary team-wa">
        <WhatsAppIcon />WhatsApp
      </a>
      <a href={tgLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary team-wa">
        <TelegramIcon />Telegram
      </a>
    </div>
  </div>
</article>

<style>
  .team-card {
    display: flex; flex-direction: column; text-align: center;
    overflow: hidden;
    padding: 0;
  }
  /* Optional per-card accent border (color from the `accent` field) */
  .team-card.has-accent {
    border: 2px solid var(--card-accent);
  }
  /* Optional outer glow in the same accent color (when `glow` is true) */
  .team-card.has-glow {
    box-shadow: 0 10px 34px -8px color-mix(in srgb, var(--card-accent) 55%, transparent);
    transition: box-shadow .25s ease, transform .25s ease;
  }
  .team-card.has-glow:hover {
    box-shadow: 0 16px 44px -6px color-mix(in srgb, var(--card-accent) 75%, transparent);
    transform: translateY(-3px);
  }
  .team-photo {
    width: 100%; height: 240px;
    object-fit: cover;
    object-position: center 22%; /* faces sit in the upper part of the photo */
    background: var(--color-bg-alt);
  }
  .team-body {
    display: flex; flex-direction: column; flex: 1;
    padding: 1.5rem;
  }
  .team-name { font-size: 1.15rem; margin-bottom: .25rem; }
  .team-role { color: var(--color-primary); font-weight: 600; margin-bottom: .75rem; font-size: .95rem; }
  .team-bio { font-size: .9rem; color: var(--color-text-muted); margin-bottom: 1rem; }
  .team-specialties { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: center; margin-bottom: 1rem; }
  .tag {
    background: var(--color-bg-alt); border: 1px solid var(--color-border);
    padding: .2rem .6rem; border-radius: 20px; font-size: .8rem;
  }
  .team-contact { display: flex; gap: .5rem; width: 100%; margin-top: auto; }
  .team-wa { flex: 1; }
</style>
